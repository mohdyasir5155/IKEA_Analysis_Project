---- Checking the Row Count after the import 

SELECT COUNT(*) AS Rows_2029_2010 FROM dbo.[Year 2009-2010]
SELECT COUNT(*) AS Rows_2010_2011 FROM dbo.[Year 2010-2011]

--- Combine Both years and convert types safely

SELECT 
	Invoice, 
	StockCode, 
	Description, 
	Quantity,
	COALESCE(
		TRY_CONVERT(datetime2, InvoiceDate, 120),
		TRY_CONVERT(datetime2, InvoiceDate, 105)
	)AS InovoiceDate,

	TRY_CONVERT(decimal(10,2), Price) AS Price,
	Customer_ID,
	Country,
	'2009-2010' AS SourceSheet
INTO dbo.RetailCombined
FROM dbo.[Year 2009-2010]

UNION ALL

SELECT 
	Invoice, 
	StockCode, 
	Description, 
	Quantity,
	COALESCE(
		TRY_CONVERT(datetime2, InvoiceDate, 120),
		TRY_CONVERT(datetime2, InvoiceDate, 105)
	)AS InovoiceDate,
	TRY_CONVERT(decimal(10,2), Price) AS Price,
	Customer_ID,
	Country,
	'2010-2011' AS SourceSheet
FROM dbo.[Year 2010-2011]

--- Checking the data is connected or not 

SELECT * FROM dbo.RetailCombined;


--- Confirming the conversion worked cleanly

SELECT COUNT(*) AS Total_Rows FROM dbo.RetailCombined;
SELECT COUNT(*) AS Failed_Dates FROM dbo.RetailCombined WHERE InovoiceDate IS NULL;
SELECT COUNT(*) AS Failed_Prices FROM dbo.RetailCombined WHERE Price IS NULL;

