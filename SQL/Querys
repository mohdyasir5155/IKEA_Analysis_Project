---- Data Exploration
----===================================================================================---

-- Check 1 : Missing Customer ID
SELECT COUNT(*) AS Missing_CustomerID
FROM dbo.RetailCombined 
WHERE Customer_ID IS NULL;

-- Check 2 : Negative Or Zero Quantity
SELECT COUNT(*) AS Negative_Qty
FROM dbo.RetailCombined 
WHERE Quantity <=0;

-- Check 3 : Missing Description
SELECT COUNT(*) AS Missing_Description 
FROM dbo.RetailCombined 
WHERE Description IS NULL;

-- Check 4 : Exact Duplicate Rows 
SELECT
	Invoice, StockCode, Description, Quantity,InovoiceDate, Price, Customer_ID , Country,
	COUNT(*) AS ExactDupeCount
FROM dbo.RetailCombined
GROUP BY Invoice, StockCode, Description, Quantity,InovoiceDate, Price, Customer_ID , Country
HAVING COUNT(*) > 1 ;

--- Removing the duplicate values and producing the clean table

WITH Deduped As (
	SELECT *,
		ROW_NUMBER() OVER (
			PARTITION by Invoice, StockCode ,Description, Quantity,InovoiceDate, Price, Customer_ID , Country
			ORDER BY (SELECT NULL)
		) AS RowNum
	FROM dbo.RetailCombined
)
SELECT Invoice, StockCode ,Description, Quantity,InovoiceDate, Price, Customer_ID , Country, SourceSheet
INTO dbo.RetailCleaned
FROM Deduped
WHERE RowNum = 1;


---- Checking the final clean table 
SELECT * FROM dbo.RetailCleaned;
